// process-compute.config — used directly as nextflow.config by Cirro
// (per Day 2 research). Single-process resource allocation since Q10
// chose the black-box wrapping option — one process gets one resource
// allocation for the entire pipeline run (tif_conversion through
// survival), which is the known tradeoff of that choice vs. five staged,
// independently-sized processes.
//
// PLACEHOLDER VALUES — not tuned against a real CRC TMA run's actual
// peak memory/CPU. Needs a real run's numbers before trusting this for
// production AWS Batch billing/sizing.

process {
    container = 'TODO: ECR image URI once Dockerfile is built and pushed'
    cpus   = 8
    memory = '32 GB'
    time   = '12h'
}

aws {
    batch {
        // TODO: AWS Batch queue name — needs Afrouz's or BTC's Cirro admin
        // to provide the actual queue/compute-environment identifiers.
    }
}
