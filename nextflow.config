// nextflow.config — LOCAL/TEST profile only.
// For Cirro deployment, Cirro uses .cirro/process-compute.config directly
// as the nextflow.config (per Day 2 research into Cirro's packaging
// convention, SPATIA_PIPELINE_LOG.md) — this root file is for running
// `nextflow run main.nf` by hand outside Cirro, e.g. to smoke-test the
// single-process wiring before an admin imports the pipeline into Cirro.

docker.enabled = true

process {
    container = 'spatia-pipeline:latest'
    cpus   = 4
    memory = '16 GB'
    // NOT yet tuned against real CRC TMA run resource usage — placeholder
    // values, needs a real run's peak RSS/CPU to size correctly before
    // this is trusted for either local or Cirro/AWS Batch use.
}
